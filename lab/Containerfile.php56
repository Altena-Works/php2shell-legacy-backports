FROM docker.io/library/php:5.6-apache@sha256:95f5e2cf93f20c1cd5199f9be5e28097c0317086c4f3492bf33a7d0dc4176b94

RUN printf 'deb http://archive.debian.org/debian stretch main\n' > /etc/apt/sources.list \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --allow-unauthenticated --no-install-recommends \
        apache2-dev autoconf build-essential libxml2-dev patch pkg-config \
    && rm -rf /var/lib/apt/lists/*
