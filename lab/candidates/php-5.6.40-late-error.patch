+ZEND_API void zend_mm_safe_error_ex(const char *format, ...)
+{
+	va_list args;
+
+	va_start(args, format);
+	fputs("\nFatal error: ", stderr);
+	vfprintf(stderr, format, args);
+	fputc('\n', stderr);
+	va_end(args);
+#ifdef PHP_WIN32
+	fflush(stderr);
+#endif
+	/* The request may contain partially initialized state. Never unwind it. */
+	_exit(1);
+}
