+static ZEND_COLD void zend_mm_delayed_error(const char *format, ...)
+{
+	zend_oom_info *info = &EG(delayed_oom);
+	zend_string *filename = NULL;
+	char buf[1024];
+	va_list args;
+
+	if (info->state != ZEND_OOM_STATE_NONE) {
+		return;
+	}
+	if (zend_is_executing()) {
+		filename = zend_get_executed_filename_ex();
+		info->lineno = zend_get_executed_lineno();
+	} else if (zend_is_compiling()) {
+		filename = zend_get_compiled_filename();
+		info->lineno = zend_get_compiled_lineno();
+	}
+	va_start(args, format);
+	vsnprintf(buf, sizeof(buf), format, args);
+	va_end(args);
+	info->message = zend_string_init(buf, strlen(buf), 1);
+	info->filename = filename ? zend_string_copy(filename) : NULL;
+	info->state = ZEND_OOM_STATE_PENDING;
+	EG(vm_interrupt) = 1;
+}
